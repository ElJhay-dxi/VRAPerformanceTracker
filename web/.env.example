# Microsoft Entra ID (Azure AD) sign-in.
# Leave VITE_ENTRA_CLIENT_ID unset to run the dev user-picker instead.
# Copy to .env.local and fill in from your Azure app registration Overview page.

# Application (client) ID of the SPA app registration
VITE_ENTRA_CLIENT_ID=

# Directory (tenant) ID
VITE_ENTRA_TENANT_ID=

# Must exactly match a redirect URI registered on the SPA (platform: Single-page application)
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# The API validates the ID token (audience = client id), so no custom API scope is needed.
